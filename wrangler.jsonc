{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "michigangaragepros",
  // Custom entry wraps OpenNext fetch + adds scheduled() for weekly digests.
  // See https://opennext.js.org/cloudflare/howtos/custom-worker
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Enable the public *.workers.dev URL in the dashboard too if it shows Disabled
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Monday 14:00 UTC ≈ 9:00 AM Eastern Standard / 10:00 AM Eastern Daylight.
  // Weekly performance digests for claimed companies (see src/lib/weekly-digest.ts).
  "triggers": {
    "crons": ["0 14 * * 1"]
  },
  // Non-secret notify defaults. Set secrets with:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put ADMIN_TOKEN
  //   npx wrangler secret put STRIPE_SECRET_KEY
  //   npx wrangler secret put STRIPE_WEBHOOK_SECRET
  // Optional: npx wrangler secret put NOTIFY_WEBHOOK_URL
  // Optional (Checkout redirect does not need it): NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
  "vars": {
    "NOTIFY_EMAIL": "nickperez@gmail.com",
    "NOTIFY_FROM_EMAIL": "Michigan Garage Pros <onboarding@resend.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "michigangaragepros",
      "database_id": "beb5b737-d0a3-479e-8343-4b7eb2b7fb1a",
      "migrations_dir": "migrations"
    }
  ],
  // Company logos + profile photos. One-time create:
  //   npx wrangler r2 bucket create michigangaragepros-media
  // Bucket stays private; Worker serves via GET /api/media/<key>.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "michigangaragepros-media"
    }
  ]
}
